{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "skipLibCheck": true,
    "outDir": "tests/.dist-server-db",
    "rootDir": "."
  },
  "include": [
    "server/auth/account/contracts.ts",
    "server/auth/emailOtp/contracts.ts",
    "server/auth/session/contracts.ts",
    "server/chat/contracts.ts",
    "server/chat/rateLimit.ts",
    "server/chat/service.ts",
    "server/persistence/postgres/rows.ts",
    "server/persistence/postgres/accountIdentityStore.ts",
    "server/persistence/postgres/emailOtpChallengeStore.ts",
    "server/persistence/postgres/rateLimitStore.ts",
    "server/persistence/postgres/sessionStore.ts",
    "server/persistence/postgres/chatStore.ts",
    "server/persistence/postgres/chatRateLimitStore.ts",
    "tests/postgres-auth-persistence-smoke.ts",
    "tests/postgres-chat-persistence-smoke.ts",
    "tests/postgres-chat-rate-limit-smoke.ts"
  ]
}
