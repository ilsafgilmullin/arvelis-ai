{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM"],
    "outDir": "tests/.dist-retrieval-knowledge-foundation",
    "rootDir": "."
  },
  "include": [
    "src/travel/aiKnowledgeContracts.ts",
    "src/travel/knowledgeIngestionContracts.ts",
    "server/travel/aiEnginePorts.ts",
    "server/travel/knowledgeEmbeddingPort.ts",
    "server/travel/knowledgeRepository.ts",
    "server/travel/knowledgeIngestionService.ts",
    "server/travel/postgresKnowledgeRetriever.ts",
    "tests/retrieval-knowledge-foundation-smoke.ts"
  ]
}
