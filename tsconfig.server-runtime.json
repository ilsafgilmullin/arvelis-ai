{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM"],
    "outDir": "server-dist",
    "rootDir": "."
  },
  "include": [
    "src/travel/domain.ts",
    "src/travel/validation.ts",
    "src/travel/planContracts.ts",
    "src/travel/transportContracts.ts",
    "src/travel/mapContracts.ts",
    "src/travel/legalContracts.ts",
    "src/travel/providers.ts",
    "server/auth/account/contracts.ts",
    "server/auth/account/displayName.ts",
    "server/auth/application/contracts.ts",
    "server/auth/application/service.ts",
    "server/auth/emailOtp/contracts.ts",
    "server/auth/emailOtp/emailAddress.ts",
    "server/auth/emailOtp/policy.ts",
    "server/auth/emailOtp/service.ts",
    "server/auth/emailOtp/smtpDelivery.ts",
    "server/auth/emailOtp/webCryptoSecurity.ts",
    "server/auth/session/contracts.ts",
    "server/auth/session/policy.ts",
    "server/auth/session/service.ts",
    "server/auth/session/webCryptoSecurity.ts",
    "server/travel/contracts.ts",
    "server/travel/service.ts",
    "server/travel/planOrchestrator.ts",
    "server/travel/transportOrchestrator.ts",
    "server/travel/mapOrchestrator.ts",
    "server/travel/legalOrchestrator.ts",
    "server/travel/transportProviderPolicy.ts",
    "server/travel/providers/yandexRaspAdapter.ts",
    "server/travel/providers/yandexRaspHttpClient.ts",
    "server/travel/providers/yandexRaspLiveProvider.ts",
    "server/persistence/postgres/rows.ts",
    "server/persistence/postgres/accountIdentityStore.ts",
    "server/persistence/postgres/emailOtpChallengeStore.ts",
    "server/persistence/postgres/rateLimitStore.ts",
    "server/persistence/postgres/sessionStore.ts",
    "server/persistence/postgres/tripStore.ts",
    "server/persistence/sqlite/database.ts",
    "server/persistence/sqlite/authStores.ts",
    "server/persistence/sqlite/tripStore.ts",
    "server/runtime/config.ts",
    "server/runtime/http.ts",
    "server/runtime/server.ts"
  ]
}
