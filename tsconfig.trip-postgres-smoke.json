{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM"],
    "outDir": "tests/.dist-trip-postgres",
    "rootDir": "."
  },
  "include": [
    "src/travel/domain.ts",
    "src/travel/validation.ts",
    "server/travel/contracts.ts",
    "server/travel/service.ts",
    "server/persistence/postgres/tripStore.ts",
    "tests/trip-postgres-persistence-smoke.ts"
  ]
}
