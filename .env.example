# ARVELIS auth runtime — examples only. Real values belong only in protected secrets/environment.

# PostgreSQL
DATABASE_URL=

# Independent high-entropy server peppers. Use at least 32 random bytes encoded as hex.
AUTH_OTP_PEPPER_HEX=
AUTH_SESSION_PEPPER_HEX=

# Auth API runtime
AUTH_API_PORT=3001
AUTH_TRUST_PROXY=false
# auto | always | never. Production HTTPS should resolve to Secure cookies.
AUTH_COOKIE_SECURE=auto

# Email delivery provider.
# Approved first provider: Yandex Cloud Postbox.
EMAIL_DELIVERY_PROVIDER=yandex_cloud_postbox

# Yandex Cloud Postbox SMTP.
# Create a service account with postbox.sender, then an API key with scope yc.postbox.send.
# POSTBOX_API_KEY_ID is the API key ID. POSTBOX_API_KEY_SECRET is the secret part.
# POSTBOX_FROM must be a verified Postbox sender/address.
# 587 + false = STARTTLS. 465 + true = SMTPS.
POSTBOX_API_KEY_ID=
POSTBOX_API_KEY_SECRET=
POSTBOX_FROM=
POSTBOX_SMTP_PORT=587
POSTBOX_SMTP_SECURE=false

# Generic SMTP fallback for a future provider switch. Not used while
# EMAIL_DELIVERY_PROVIDER=yandex_cloud_postbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Frontend rollout switch. Keep false until DB migration + Postbox secrets + auth API are configured.
VITE_REAL_AUTH_ENABLED=false
