# ARVELIS auth runtime — examples only. Real values belong only in protected secrets/environment.

# PostgreSQL
DATABASE_URL=

# Independent high-entropy server peppers. Use at least 32 random bytes encoded as hex.
AUTH_OTP_PEPPER_HEX=
AUTH_SESSION_PEPPER_HEX=

# Auth API runtime
AUTH_API_PORT=3001
AUTH_TRUST_PROXY=false
# auto | always | never. Production HTTPS should resolve to Secure cookies.
AUTH_COOKIE_SECURE=auto

# SMTP delivery. Yandex Cloud Postbox candidate: postbox.cloud.yandex.net, port 587 STARTTLS or 465 SMTPS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Frontend rollout switch. Keep false until DB migration + SMTP secrets + auth API are configured.
VITE_REAL_AUTH_ENABLED=false
