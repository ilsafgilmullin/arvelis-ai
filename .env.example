# ARVELIS auth runtime — examples only. Real values belong only in protected secrets/environment.

# Auth persistence.
# Closed-test default: local SQLite file, no external DB account or billing required.
AUTH_DB_PROVIDER=sqlite
AUTH_SQLITE_PATH=.data/arvelis-auth.sqlite

# Optional future PostgreSQL path. Used only when AUTH_DB_PROVIDER=postgres.
DATABASE_URL=

# Independent high-entropy server peppers. Use at least 32 random bytes encoded as hex.
AUTH_OTP_PEPPER_HEX=
AUTH_SESSION_PEPPER_HEX=

# Auth API runtime
AUTH_API_PORT=3001
AUTH_TRUST_PROXY=false
# auto | always | never. Production HTTPS should resolve to Secure cookies.
AUTH_COOKIE_SECURE=auto

# SMTP delivery.
# Free closed-test path: regular Yandex Mail mailbox, no Yandex Cloud billing and no custom domain required.
# Official Yandex Mail SMTP: smtp.yandex.ru:465 with SSL.
# Use a separate Mail app password, never the normal Yandex ID password.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Frontend rollout switch. Keep false until SQLite + SMTP secrets + auth API are configured and tested.
VITE_REAL_AUTH_ENABLED=false

# Yandex Rasp Live Adapter V1 — server-side only. Never expose the API key to Vite/frontend.
# Development key: create/activate it through the official Yandex developer flow and store
# it only in a protected development secret/environment. Never commit it to this file.
# Leave empty/false to keep the provider disabled/not_connected.
YANDEX_RASP_API_KEY=
# ISO timestamp of a fresh official terms review performed immediately before an approved live smoke/activation.
YANDEX_RASP_TERMS_RECHECKED_AT=
# Set true only after the quota/limits for the actual issued key have been confirmed.
YANDEX_RASP_QUOTA_CONFIRMED=false

# Operational gates. Preparation of UI/code does not make these true automatically;
# production activation remains a separate explicit decision.
YANDEX_RASP_ATTRIBUTION_IMPLEMENTED=false
YANDEX_RASP_OPERATIONAL_POLICY_ACCEPTED=false

# Normalized read-only path. No URL override. False keeps all network disabled.
YANDEX_RASP_NETWORK_ENABLED=false
YANDEX_RASP_FREE_PUBLIC_CONFIRMED=false
# Application limits, not a statement of issued-key provider quota.
YANDEX_RASP_TIMEOUT_MS=10000
YANDEX_RASP_REQUESTS_PER_MINUTE=30
