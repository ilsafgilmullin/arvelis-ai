{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM"],
    "outDir": "tests/.dist-yandex-rasp-live",
    "rootDir": "."
  },
  "include": [
    "src/travel/domain.ts",
    "src/travel/transportContracts.ts",
    "src/travel/providers.ts",
    "src/travel/locationResolution.ts",
    "server/travel/locationResolutionService.ts",
    "server/travel/routesLocationBoundary.ts",
    "server/travel/routesResolutionService.ts",
    "server/travel/transportOrchestrator.ts",
    "server/travel/transportProviderPolicy.ts",
    "server/travel/providers/yandexRaspAdapter.ts",
    "server/travel/providers/yandexRaspHttpClient.ts",
    "server/travel/providers/yandexRaspLiveProvider.ts",
    "server/travel/providers/yandexRaspNormalizedProvider.ts",
    "server/travel/providers/yandexRaspSearchMapping.ts",
    "server/travel/providers/yandexRaspTrustedBindings.ts",
    "server/travel/providers/yandexRaspRuntimeProvider.ts",
    "server/travel/providers/trustedLocationProviderBinding.ts",
    "tests/yandex-rasp-live-adapter-smoke.ts",
    "tests/yandex-rasp-normalized-provider-smoke.ts",
    "tests/yandex-rasp-trusted-bindings-smoke.ts",
    "tests/yandex-rasp-runtime-provider-smoke.ts",
    "tests/yandex-rasp-development-live-smoke.ts",
    "tests/trusted-location-provider-binding-smoke.ts",
    "tests/routes-location-boundary-smoke.ts",
    "tests/routes-resolution-service-smoke.ts"
  ]
}
