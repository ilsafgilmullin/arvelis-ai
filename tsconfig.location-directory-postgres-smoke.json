{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM"],
    "outDir": "tests/.dist-location-directory-postgres",
    "rootDir": "."
  },
  "include": [
    "src/travel/locationResolution.ts",
    "src/travel/transportSearchRequest.ts",
    "server/travel/locationResolutionService.ts",
    "server/travel/locationDirectoryFoundation.ts",
    "server/persistence/postgres/locationDirectoryRepository.ts",
    "tests/location-directory-postgres-persistence-smoke.ts"
  ]
}
