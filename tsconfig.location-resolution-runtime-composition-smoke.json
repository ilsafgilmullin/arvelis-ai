{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM"],
    "outDir": "tests/.dist-location-resolution-runtime-composition",
    "rootDir": "."
  },
  "include": [
    "src/travel/locationResolution.ts",
    "server/travel/locationResolutionService.ts",
    "server/travel/locationDirectoryFoundation.ts",
    "server/travel/locationDirectoryActivation.ts",
    "server/travel/activeLocationResolutionService.ts",
    "server/persistence/sqlite/database.ts",
    "server/persistence/sqlite/locationDirectoryRepository.ts",
    "server/persistence/sqlite/locationDirectoryActivationRepository.ts",
    "server/persistence/postgres/locationDirectoryRepository.ts",
    "server/persistence/postgres/locationDirectoryActivationRepository.ts",
    "server/runtime/locationResolutionComposition.ts",
    "tests/location-resolution-runtime-composition-smoke.ts"
  ]
}
