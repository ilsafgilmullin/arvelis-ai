{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM"],
    "outDir": "tests/.dist-server-sqlite",
    "rootDir": "."
  },
  "include": [
    "server/auth/account/contracts.ts",
    "server/auth/emailOtp/contracts.ts",
    "server/auth/session/contracts.ts",
    "server/persistence/sqlite/database.ts",
    "server/persistence/sqlite/authStores.ts",
    "tests/sqlite-auth-persistence-smoke.ts"
  ]
}
