{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "outDir": "tests/.dist-server-auth",
    "rootDir": "."
  },
  "include": [
    "server/auth/emailOtp/contracts.ts",
    "server/auth/emailOtp/policy.ts",
    "server/auth/emailOtp/emailAddress.ts",
    "server/auth/emailOtp/webCryptoSecurity.ts",
    "server/auth/emailOtp/service.ts",
    "tests/email-otp-core-smoke.ts"
  ]
}
