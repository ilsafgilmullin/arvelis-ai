{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM"],
    "outDir": "tests/.dist-knowledge-postgres-foundation",
    "rootDir": "."
  },
  "include": [
    "src/travel/knowledgeIngestionContracts.ts",
    "server/travel/knowledgeRepository.ts",
    "server/persistence/postgres/knowledgeRepository.ts",
    "tests/knowledge-postgres-foundation-smoke.ts"
  ]
}
