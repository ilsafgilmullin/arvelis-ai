{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM"],
    "outDir": "tests/.dist-map-provider-foundation",
    "rootDir": "."
  },
  "include": [
    "src/travel/domain.ts",
    "src/travel/mapContracts.ts",
    "src/travel/planContracts.ts",
    "src/travel/transportContracts.ts",
    "src/travel/providers.ts",
    "server/travel/mapOrchestrator.ts",
    "tests/map-provider-foundation-smoke.ts"
  ]
}
