{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "outDir": "tests/.dist-auth",
    "rootDir": "."
  },
  "include": [
    "src/auth/contracts.ts",
    "src/auth/protocolLimits.ts",
    "src/auth/reducer.ts",
    "src/auth/runtimeGuards.ts",
    "src/auth/guardedGateway.ts",
    "src/auth/externalFlow.ts",
    "tests/auth-core-smoke.ts"
  ]
}
